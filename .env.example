# Copy to .env. Everything here is a LOCAL DEV default, not a secret.
POSTGRES_USER=sarovar
POSTGRES_PASSWORD=sarovar_dev_pw
POSTGRES_HOST_PORT=5433
OLTP_DB=sarovar_oltp

MINIO_ROOT_USER=minio_dev
MINIO_ROOT_PASSWORD=minio_dev_pw
MINIO_BUCKET=lake

AIRFLOW_HOST_PORT=8081
TRINO_HOST_PORT=8080
API_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
SUPERSET_HOST_PORT=8088

# Ollama runs on the host (https://ollama.com); containers reach it via host.docker.internal
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text

# Optional: only for the real-S3 verification pass (leave empty otherwise)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
